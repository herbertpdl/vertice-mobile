{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.20.0"
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_APP_ENV": "development", "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "preview" }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
