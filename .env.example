# URL of the vertice-bff instance this app talks to. Must be reachable from
# the device/simulator (not just this machine) - on a physical device,
# localhost refers to the device itself, so use your machine's LAN IP instead.
#
# Unlike vertice-web-react, there is no server-side proxy here, so this is
# EXPO_PUBLIC_ (bundled into the client) and the BFF is called directly.
EXPO_PUBLIC_BFF_URL=http://localhost:3000

# The web app (vertice-web-react). The app links to its legal pages (/termos,
# /privacidade) instead of shipping its own copy of the texts.
EXPO_PUBLIC_WEB_URL=http://localhost:5173
